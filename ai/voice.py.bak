from __future__ import annotations

import json
import os
from dataclasses import dataclass
from pathlib import Path
from typing import Any

try:
    import sounddevice as sd
except ImportError:  # pragma: no cover
    sd = None  # type: ignore[assignment]

try:
    import pyaudio
except ImportError:  # pragma: no cover
    pyaudio = None  # type: ignore[assignment]

try:
    from vosk import KaldiRecognizer, Model
except ImportError:  # pragma: no cover
    KaldiRecognizer = None  # type: ignore[assignment]
    Model = None  # type: ignore[assignment]


@dataclass(frozen=True)
class VoiceResult:
    ok: bool
    message: str
    text: str = ""
    data: dict[str, Any] | None = None


class VoiceEngine:
    """Offline voice capture/transcription for the AIOS command center.

    Prefers sounddevice and falls back to PyAudio on Windows when the
    sounddevice backend is unavailable or cannot open the default microphone.
    """

    def __init__(self) -> None:
        self.model_path = self._find_model()
        self.sample_rate = 16000
        self.channels = 1
        self.chunk = 1024
        self._model = None
        self._backend = self._detect_backend()

    def _find_model(self) -> Path | None:
        configured = os.environ.get("AIOS_VOSK_MODEL")
        candidates: list[Path] = []
        if configured:
            candidates.append(Path(configured).expanduser())

        root = Path(__file__).resolve().parents[1]
        home = Path.home()
        desktop = home / "Desktop"
        candidates.extend(
            [
                home / ".aios" / "models" / "vosk-model-small-en-us-0.15",
                root / "models" / "stt" / "vosk-model-small-en-us-0.15",
                desktop / "AIOS" / "models" / "stt" / "vosk-model-small-en-us-0.15",
                desktop / "JARVIS_OFFLINE" / "models" / "stt" / "vosk-model-small-en-us-0.15",
                desktop / "OfflineAssistant" / "models" / "stt" / "vosk-model-small-en-us-0.15",
            ]
        )
        for candidate in candidates:
            if candidate.is_dir():
                return candidate
        return None

    def _detect_backend(self) -> str | None:
        if sd is not None:
            try:
                sd.query_devices(kind="input")
                return "sounddevice"
            except Exception:
                pass
        if pyaudio is not None:
            audio = None
            try:
                audio = pyaudio.PyAudio()
                info = audio.get_default_input_device_info()
                if int(info.get("maxInputChannels", 0)) > 0:
                    return "pyaudio"
            except Exception:
                return None
            finally:
                if audio is not None:
                    audio.terminate()
        return None

    def status(self) -> dict[str, Any]:
        vosk_ready = Model is not None and KaldiRecognizer is not None
        return {
            "microphone_backend": self._backend is not None,
            "backend": self._backend,
            "sounddevice": sd is not None,
            "pyaudio": pyaudio is not None,
            "vosk": vosk_ready,
            "model_path": str(self.model_path) if self.model_path else None,
            "ready": self._backend is not None and vosk_ready and self.model_path is not None,
        }

    def _load_model(self):
        if self._model is None:
            if Model is None:
                raise RuntimeError("Vosk is not installed")
            if self.model_path is None:
                raise RuntimeError("Vosk model not found")
            self._model = Model(str(self.model_path))
        return self._model

    def _transcribe(self, pcm: bytes) -> str:
        recognizer = KaldiRecognizer(self._load_model(), self.sample_rate)
        if recognizer.AcceptWaveform(pcm):
            result = json.loads(recognizer.Result())
        else:
            result = json.loads(recognizer.FinalResult())
        return str(result.get("text", "")).strip()

    def _record_sounddevice(self, seconds: int) -> bytes:
        if sd is None:
            raise RuntimeError("sounddevice is unavailable")
        frames = int(self.sample_rate * seconds)
        recording = sd.rec(frames, samplerate=self.sample_rate, channels=self.channels, dtype="int16")
        sd.wait()
        return recording.reshape(-1).tobytes()

    def _record_pyaudio(self, seconds: int) -> bytes:
        if pyaudio is None:
            raise RuntimeError("PyAudio is unavailable")
        audio = pyaudio.PyAudio()
        stream = None
        chunks: list[bytes] = []
        try:
            stream = audio.open(
                format=pyaudio.paInt16,
                channels=self.channels,
                rate=self.sample_rate,
                input=True,
                frames_per_buffer=self.chunk,
            )
            for _ in range(max(1, int(self.sample_rate / self.chunk * seconds))):
                chunks.append(stream.read(self.chunk, exception_on_overflow=False))
        finally:
            if stream is not None:
                stream.stop_stream()
                stream.close()
            audio.terminate()
        return b"".join(chunks)

    def record_and_transcribe(self, seconds: int = 5) -> VoiceResult:
        seconds = max(1, min(int(seconds), 15))
        if Model is None or KaldiRecognizer is None:
            return VoiceResult(False, "Local voice engine unavailable. Install vosk.", data=self.status())
        if self.model_path is None:
            return VoiceResult(
                False,
                "Vosk model not found. Set AIOS_VOSK_MODEL to a local model directory.",
                data=self.status(),
            )

        backends = []
        if self._backend == "sounddevice":
            backends = ["sounddevice", "pyaudio"]
        elif self._backend == "pyaudio":
            backends = ["pyaudio", "sounddevice"]
        else:
            backends = ["sounddevice", "pyaudio"]

        errors: list[str] = []
        for backend in backends:
            try:
                pcm = self._record_sounddevice(seconds) if backend == "sounddevice" else self._record_pyaudio(seconds)
                text = self._transcribe(pcm)
                self._backend = backend
                if not text:
                    return VoiceResult(False, "No speech was detected. Please speak clearly and try again.", data=self.status())
                return VoiceResult(True, "Voice command transcribed.", text=text, data=self.status())
            except Exception as exc:
                errors.append(f"{backend}: {exc}")

        return VoiceResult(False, "Microphone capture failed. " + " | ".join(errors), data=self.status())
